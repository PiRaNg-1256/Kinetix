# ─────────────────────────────────────────────────────────────────────────────
# Kinetix configuration. Copy to .env.local for local dev, or add these in
# Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set, /demo works with the offline engine.
# ─────────────────────────────────────────────────────────────────────────────

# Claude — powers the chat agent and (in live mode) message triage.
ANTHROPIC_API_KEY=
# KINETIX_MODEL=claude-opus-5-5

# Public demo controls
# KINETIX_DEMO_USE_CLAUDE=true      # set to "false" to keep /demo fully offline (zero API spend)
# KINETIX_DEMO_RATE_LIMIT=30        # Claude-backed demo questions per IP per hour

# ── Live mode (your real tools) ──────────────────────────────────────────────
# Required to enable live mode at /app. 12+ characters. Without it, live mode stays off.
KINETIX_ACCESS_KEY=

# Who you are
KINETIX_USER_NAME="Jane Doe"
KINETIX_USER_EMAIL=jane@yourco.com
KINETIX_TIMEZONE=America/New_York
# KINETIX_USER_ROLE="Head of Product"
# KINETIX_LOOKBACK_DAYS=3

# Sharper prioritization (optional)
# KINETIX_VIPS=ceo@yourco.com,Board Member Name
# KINETIX_CUSTOMER_DOMAINS=bigcustomer.com,othercustomer.io
# KINETIX_PROJECTS=[{"id":"launch","name":"Q1 launch","keywords":["launch","ga"],"criticality":1,"targetDate":"2026-12-01"}]
# KINETIX_LLM_TRIAGE=off            # disable the Claude triage pass in live mode

# Gmail + Google Calendar (one OAuth client, scopes: gmail.readonly gmail.compose calendar.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack (user token xoxp-…, scopes: search:read users:read)
SLACK_USER_TOKEN=

# Notion (internal integration secret; share pages with the integration)
NOTION_TOKEN=

# Jira Cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_JQL=assignee = currentUser() AND updated >= -7d ORDER BY updated DESC

# Linear (personal API key)
LINEAR_API_KEY=
